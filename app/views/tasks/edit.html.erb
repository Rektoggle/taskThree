<h1 class="text-2xl font-bold mb-4">Editar tarea</h1>

<%= form_with model: @task, local: true do |form| %>
  <div class="mb-4">
    <%= form.label :title, "Título", class: "block font-semibold mb-1" %>
    <%= form.text_field :title, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :description, "Descripción", class: "block font-semibold mb-1" %>
    <%= form.text_area :description, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mt-4">
    <%= form.submit "💾 Guardar cambios", class: "bg-green-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>

<%= link_to "⬅️ Volver", tasks_path, class: "text-blue-500 mt-4 inline-block" %>

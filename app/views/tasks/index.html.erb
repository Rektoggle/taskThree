<h1 class="text-2xl font-bold mb-4">Crear nueva tarea</h1>

<%= form_with model: @task, url: tasks_path, local: true do |form| %>
  <div class="mb-4">
    <%= form.label :title, "Título", class: "block font-semibold mb-1" %>
    <%= form.text_field :title, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mb-4">
    <%= form.label :description, "Descripción", class: "block font-semibold mb-1" %>
    <%= form.text_area :description, class: "border rounded p-2 w-full" %>
  </div>

  <div class="mt-4">
    <%= form.submit "➕ Crear tarea", class: "bg-blue-500 text-white px-4 py-2 rounded" %>
  </div>
<% end %>

<hr class="my-6">

<h2 class="text-xl font-semibold mb-2">Tareas</h2>
<ul>
  <% @tasks.each do |task| %>
    <li class="mb-4">
      <div class="flex justify-between items-center">
        <div>
          <strong><%= task.title %></strong>: <%= task.description %>
        </div>
        <%= link_to "Ver tarea", task_path(task.slug), class: "bg-green-500 text-white px-2 py-1 rounded" %>
      </div>
    </li>
  <% end %>
</ul>
